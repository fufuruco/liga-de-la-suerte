{
  "name": "Sesion",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre de la partida o liga"
    },
    "jornadas": {
      "type": "number",
      "default": 6,
      "description": "Cantidad de jornadas de la partida"
    },
    "estado": {
      "type": "string",
      "enum": [
        "en_curso",
        "finalizada"
      ],
      "default": "en_curso"
    },
    "campeon": {
      "type": "string",
      "description": "Equipo con m\u00e1s puntos al finalizar"
    }
  },
  "required": [
    "nombre",
    "jornadas"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}